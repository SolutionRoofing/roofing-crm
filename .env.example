# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API Keys). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key. Safe in the browser: the database rules do the protecting.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The "secret" key. Server only: used to send invites and by the import script.
SUPABASE_SECRET_KEY=sb_secret_...

# Email (Resend). Save the key with: scripts\save-key.ps1 -Name RESEND_API_KEY -Prefix re_
RESEND_API_KEY=
# Sender shown to customers; the domain must be verified in Resend.
EMAIL_FROM=Your Roofing Company <crm@yourcompany.com>
# From Resend > Webhooks, once the app is online (delivered / opened / bounced tracking).
RESEND_WEBHOOK_SECRET=
# Random string; Vercel Cron sends it to /api/cron/send-emails.
CRON_SECRET=
# The app's public address, used in email links (http://localhost:3000 until it is online).
SITE_URL=http://localhost:3000

# Optional. Google Places key for address suggestions (better house-number coverage).
# Leave blank to use the free Photon service instead. See UPGRADES.md.
GOOGLE_MAPS_API_KEY=
