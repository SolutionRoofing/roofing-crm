# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API Keys). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key. Safe in the browser: the database rules do the protecting.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The "secret" key. Server only: used to send invites and by the import script.
SUPABASE_SECRET_KEY=sb_secret_...
